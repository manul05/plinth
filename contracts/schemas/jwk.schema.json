{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plinth.invalid/schemas/jwk.schema.json",
  "title": "Public JWK (Ed25519 or P-256 only)",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kty": {
          "const": "OKP"
        },
        "crv": {
          "const": "Ed25519"
        },
        "x": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        }
      },
      "required": [
        "kty",
        "crv",
        "x"
      ],
      "not": {
        "required": [
          "d"
        ]
      }
    },
    {
      "type": "object",
      "properties": {
        "kty": {
          "const": "EC"
        },
        "crv": {
          "const": "P-256"
        },
        "x": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "y": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        }
      },
      "required": [
        "kty",
        "crv",
        "x",
        "y"
      ],
      "not": {
        "required": [
          "d"
        ]
      }
    }
  ]
}
