{"pack_id":"pk.pii.india","spec":"pk-rulepack/1.0","tests":[{"expect":"match","input_parts":["Aadhaar: 2949 1013 6515"],"note":"synthetic number with a valid Verhoeff check digit","rule_id":"pk.pii.in.aadhaar"},{"expect":"no_match","input_parts":["Aadhaar: 294910136516"],"note":"wrong check digit","rule_id":"pk.pii.in.aadhaar"},{"expect":"match","input_parts":["PAN ABCPE1234F on file"],"rule_id":"pk.pii.in.pan"},{"expect":"no_match","input_parts":["code ABCXE1234F"],"note":"X is not a holder type","rule_id":"pk.pii.in.pan"},{"expect":"match","input_parts":["call +91 98765 43210"],"note":"5+5 split with +91 prefix","rule_id":"pk.pii.in.mobile"},{"expect":"no_match","input_parts":["order 5876543210"],"note":"starts with 5","rule_id":"pk.pii.in.mobile"},{"expect":"match","input_parts":["pay ramesh.k@okaxis today"],"rule_id":"pk.pii.in.upi_id"},{"expect":"no_match","input_parts":["ramesh@example"],"note":"handle not in list","rule_id":"pk.pii.in.upi_id"},{"expect":"match","input_parts":["IFSC SBIN0001234"],"rule_id":"pk.pii.in.ifsc"},{"expect":"no_match","input_parts":["SBIN1001234"],"note":"fifth character is not 0","rule_id":"pk.pii.in.ifsc"},{"expect":"match","input_parts":["GSTIN 29ABCDE1234F1ZW"],"note":"synthetic GSTIN with a valid check character","rule_id":"pk.pii.in.gstin"},{"expect":"no_match","input_parts":["GSTIN 29ABCDE1234F1ZA"],"note":"wrong check character","rule_id":"pk.pii.in.gstin"},{"expect":"match","input_parts":["mail priya.s@example.in"],"rule_id":"pk.pii.email"},{"expect":"no_match","input_parts":["priya.s@localhost"],"note":"no top-level domain","rule_id":"pk.pii.email"}]}